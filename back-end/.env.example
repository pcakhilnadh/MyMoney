# Copy to .env and fill in. Never commit .env.

# PostgreSQL (e.g. Supabase session pooler). URL-encode special characters in the password.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres

# Google OAuth Web client ID (same value as the front-end's VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=

# Front-end origins allowed to call the API, as a JSON list.
CORS_ORIGINS=["http://localhost:5173"]
APP_URL=http://localhost:5173

# AI bill and food analysis: pick a provider and set its key.
EXPENSE_AI_PROVIDER=deepseek
EXPENSE_AI_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
NVIDIA_API_KEY=

# Optional: invite emails. Without these, the app offers a share link instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
